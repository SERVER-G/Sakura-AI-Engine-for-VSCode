{
  "name": "sakura-ai-engine",
  "displayName": "Sakura AI Engine",
  "description": "さくらのAI Engine を VS Code Copilot Chat のモデルプロバイダーとして統合。モデル自動検出、トークン使用量追跡、ワークスペースRAG、Responses API対応",
  "version": "0.1.0",
  "publisher": "SERVER-G",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "sakura",
    "ai",
    "chat",
    "copilot",
    "language-model",
    "llm"
  ],
  "activationEvents": [
    "onLanguageModelChat:sakura-ai-engine"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "contributes": {
    "configuration": {
      "title": "Sakura AI Engine",
      "properties": {
        "sakuraAiEngine.baseUrl": {
          "type": "string",
          "default": "https://api.ai.sakura.ad.jp",
          "description": "さくらのAI Engine のベース URL",
          "order": 1
        },
        "sakuraAiEngine.defaultTransport": {
          "type": "string",
          "enum": [
            "chat-completions"
          ],
          "default": "chat-completions",
          "description": "使用するトランスポート (現在は chat-completions のみ対応)",
          "order": 2
        },
        "sakuraAiEngine.requestTimeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "リクエスト総タイムアウト (ミリ秒)",
          "order": 3
        },
        "sakuraAiEngine.connectTimeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "接続タイムアウト (ミリ秒)",
          "order": 4
        },
        "sakuraAiEngine.readIdleTimeoutMs": {
          "type": "number",
          "default": 60000,
          "description": "読み取りアイドルタイムアウト (ミリ秒)",
          "order": 5
        },
        "sakuraAiEngine.maxConcurrentRequests": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "最大同時リクエスト数",
          "order": 6
        },
        "sakuraAiEngine.enableVision": {
          "type": "boolean",
          "default": true,
          "description": "画像入力 (Vision) 機能を有効にする",
          "order": 7
        },
        "sakuraAiEngine.enableToolCalling": {
          "type": "boolean",
          "default": true,
          "description": "ツール呼び出し機能を有効にする",
          "order": 8
        },
        "sakuraAiEngine.enableRag": {
          "type": "boolean",
          "default": false,
          "description": "ワークスペースのコードを自動検索してチャットに追加する (RAG)。事前に「ワークスペースをインデックス化」が必要",
          "order": 9
        },
        "sakuraAiEngine.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "デバッグログを有効にする (本文・画像・ツール引数は秘匿されます)",
          "order": 9
        },
        "sakuraAiEngine.showTokenUsage": {
          "type": "boolean",
          "default": true,
          "description": "ステータスバーにトークン使用量と推定コストを表示する",
          "order": 10
        },
        "sakuraAiEngine.allowInsecureHttpForLocalDev": {
          "type": "boolean",
          "default": false,
          "description": "ローカル開発用に HTTP (非 TLS) を許可する (本番環境では使用しないでください)",
          "order": 10
        },
        "sakuraAiEngine.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "生成の多様性 (低いほど決定的、高いほど多様)",
          "order": 11
        },
        "sakuraAiEngine.frequencyPenalty": {
          "type": "number",
          "default": 0.3,
          "minimum": -2,
          "maximum": 2,
          "description": "同じトークンの繰り返しを抑制するペナルティ (高いほど繰り返しを抑制)",
          "order": 12
        },
        "sakuraAiEngine.presencePenalty": {
          "type": "number",
          "default": 0.1,
          "minimum": -2,
          "maximum": 2,
          "description": "新しいトークンの出現を促進するペナルティ",
          "order": 13
        },
        "sakuraAiEngine.models": {
          "type": "array",
          "default": [],
          "description": "カスタムモデル定義の上書き設定",
          "items": {
            "type": "object"
          },
          "order": 11
        }
      }
    },
    "commands": [
      {
        "command": "sakuraAiEngine.testConnection",
        "title": "Sakura AI Engine: 接続テスト"
      },
      {
        "command": "sakuraAiEngine.setApiKey",
        "title": "Sakura AI Engine: API キーを設定"
      },
      {
        "command": "sakuraAiEngine.clearApiKey",
        "title": "Sakura AI Engine: API キーを削除"
      },
      {
        "command": "sakuraAiEngine.indexWorkspace",
        "title": "Sakura AI Engine: ワークスペースをインデックス化",
        "when": "config.sakuraAiEngine.enableRag"
      },
      {
        "command": "sakuraAiEngine.clearIndex",
        "title": "Sakura AI Engine: インデックスをクリア",
        "when": "config.sakuraAiEngine.enableRag"
      },
      {
        "command": "sakuraAiEngine.showUsageDetails",
        "title": "Sakura AI Engine: 使用量の詳細を表示"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "sakura-ai-engine",
        "displayName": "Sakura AI Engine"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "build:watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "vscode-test",
    "pretest:integration": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/__mocks__/vscode.ts",
      "^(.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/test/unit/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
